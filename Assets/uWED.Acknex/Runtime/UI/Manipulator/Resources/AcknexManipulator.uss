.acknex-picker-detail-row {
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.15);
    padding-bottom: 1px;
    padding-top: 1px;
}

.acknex-picker-detail-info {
    margin-left: 6px;
    flex-grow: 1;
}

.acknex-picker-template-name {
    color: rgb(220, 220, 220);
    -unity-font-style: bold;
}

.acknex-picker-texture-info {
    color: rgb(150, 150, 150);
    font-size: 11px;
}

.acknex-picker-action-icon {
    color: rgb(255, 204, 26);
    margin-left: 6px;
    font-size: 16px;
}

.acknex-picker-stacked-icon {
    color: rgb(110, 180, 255);
    margin-left: 6px;
    font-size: 28px;
    -unity-font-style: bold;
}

.acknex-picker-icon-row {
    flex-direction: row;
    align-items: center;
}

.acknex-defaults-row {
    flex-direction: row;
    margin-top: 4px;
    margin-bottom: 3px;
}

.acknex-defaults-hint {
    color: rgb(150, 150, 150);
    font-size: 10px;
    padding-left: 24px;
}

.acknex-defaults-reset-button {
    height: 18px;
    padding: 0 8px;
    margin: 0 0 0 8px;
    border-radius: 3px;
    border-width: 0;
    background-color: rgb(65, 65, 65);
    color: rgb(220, 220, 220);
}

.acknex-defaults-reset-button:hover {
    background-color: rgb(85, 85, 85);
}

.acknex-template-bar {
    background-color: rgb(38, 38, 38);
    border-radius: 4px;
    padding: 6px 8px;
    margin-top: 6px;
    margin-bottom: 8px;
}

.acknex-template-bar-header {
    flex-direction: row;
    align-items: center;
}

.acknex-template-bar-usage {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    color: rgb(220, 220, 220);
    -unity-font-style: bold;
}

.acknex-template-bar-note {
    color: rgb(150, 150, 150);
    font-size: 11px;
}

.acknex-template-bar-buttons {
    flex-direction: row;
    flex-shrink: 0;
    margin-left: 8px;
}

.acknex-template-bar-button {
    height: 18px;
    padding: 0 8px;
    margin: 0 0 0 6px;
    border-radius: 3px;
    border-width: 0;
    background-color: rgb(65, 65, 65);
    color: rgb(220, 220, 220);
}

.acknex-template-bar-button:hover {
    background-color: rgb(85, 85, 85);
}
